{
    "name": "phpnomad/mysql-integration",
    "description": "",
    "type": "library",
    "homepage": "https://github.com/phoenix/core",
    "readme": "README.md",
    "license": "MIT",
    "scripts": {
        "php-cs-fixer": "php-cs-fixer fix"
    },
    "autoload": {
        "psr-4": {
            "PHPNomad\\MySql\\Integration\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPNomad\\MySql\\Integration\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Alex Standiford",
            "email": "alex@standiford.us"
        }
    ],
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "type": "git",
            "url": "git@github.com:phpnomad/db.git"
        }
    ],
    "require": {
        "phpnomad/db": "dev-codex/operation-local-handler-bridge#4b0b7709e5945a4290b04c2e3562ef919923ed08 as 2.2.x-dev",
        "phpnomad/loader": "^1.0 || ^2.0",
        "phpnomad/logger": "^1.0",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpnomad/tests": "^0.1.0 || ^0.3.0"
    }
}
